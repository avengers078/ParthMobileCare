{
  "name": "parthmobilecare-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Parth Mobile Care",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --watchman=false",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "jest": "^29.6.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.4.5"
  }
}
